{
  "version": "0.0.1",
  "name": "accountgoweb",
  "private": true,
  "scripts": {
    "icons": "node scripts/copy-coreui-icons.mjs",
    "postinstall": "node scripts/copy-coreui-icons.mjs",
    "webpack": "webpack",
    "gulp": "gulp",
    "tsc": "tsc",
    "css": "npm run css-compile-minified",
    "css-compile-minified": "sass Scss:wwwroot/css --style=compressed --source-map --load-path=. --quiet-deps",
    "build:styles": "npm run css",
    "build:web": "npm run css",
    "css:migrate": "sass-migrator module --migrate-deps --load-path . Scss/dark.scss && sass-migrator module --migrate-deps --load-path . Scss/light.scss && sass-migrator module --migrate-deps --load-path . Scss/vendors/pace-progress/pace.scss"
  },
  "devDependencies": {
    "@coreui/coreui": "^5.2.0",
    "@coreui/icons": "^0.3.0",
    "ag-grid-community": "^31.3.4",
    "ajv": "^6.12.6",
    "axios": "^1.8.2",
    "bootstrap": "^5.2.3",
    "gulp": "^4.0.2",
    "html2canvas": "^1.4.1",
    "ionicons": "^4.6.3",
    "jquery": "^3.6.4",
    "mobx": "^5.15.7",
    "mobx-react": "^5.4.4",
    "mobx-react-devtools": "^6.1.1",
    "sass": "^1.85.0",
    "sass-migrator": "^2.5.7",
    "perfect-scrollbar": "^1.5.5",
    "popper.js": "^1.16.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-router": "^4.3.1",
    "simple-line-icons": "^2.5.5",
    "ts-loader": "^9.4.2",
    "tsd": "^0.28.0",
    "typescript": "^5.0.2",
    "webpack": "^5.99.5",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "accounting": "0.4.1",
    "ag-grid": "18.1.2",
    "d3": "7.8.2",
    "font-awesome": "^4.7.0",
    "jspdf": "3.0.1",
    "knockout": "^3.5.0",
    "knockout-mapping": "2.6.0",
    "pace-progress": "^1.0.2",
    "react-dom-factories": "1.0.2"
  }
}
